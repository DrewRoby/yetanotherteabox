{
  "name": "teabox-server",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio",
    "build:linux": "bash scripts/build-linux.sh",
    "build:windows": "bash scripts/build-windows.sh",
    "check:migration-spec": "tsx scripts/check-migration-spec-freshness.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "pkg": {
    "assets": [
      "node_modules/.prisma/client/**/*",
      "node_modules/@prisma/client/**/*",
      "public/**/*",
      "prisma/template.db"
    ]
  },
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.15",
    "@yao-pkg/pkg": "^6.22.0",
    "prisma": "^5.19.1",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4"
  },
  "bin": "dist/index.js"
}
