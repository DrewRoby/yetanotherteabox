# Source: the dockerized SQL Server in /home/crow/code/fetters/db-analysis,
# after RWD.bak has been restored into it (see Docs/Migrations/liberty-etl/README.md).
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_USER=sa
MSSQL_PASSWORD=
MSSQL_DATABASE=Liberty
MSSQL_ENCRYPT=false

# Windows alternative (native SQL Server Express, Windows-auth-only, TCP disabled):
# uncomment these instead of the sa/TCP settings above — see README.md's "Windows /
# native SQL Server Express" section. MSSQL_USER/PASSWORD/PORT/ENCRYPT are unused then.
#MSSQL_HOST=localhost\SQLEXPRESS
#MSSQL_DATABASE=RWD
#MSSQL_TRUSTED_CONNECTION=true
#MSSQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server

# Target: a SCRATCH Teabox SQLite file — never the real dev/demo DB.
# `prisma migrate dev` (against server/prisma/schema.prisma) must have been run
# against this path at least once before `npm run migrate`.
TEABOX_DATABASE_URL=file:./scratch-teabox.db
