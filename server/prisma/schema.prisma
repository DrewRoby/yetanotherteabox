// Teabox ERP data model.
//
// NOTE: datasource is SQLite for zero-setup local/offline operation (this doubles as
// the "offline fallback engine" described in backend_structure_document.md). To point
// at Postgres for a shared/cloud deployment, change `provider` below to "postgresql"
// and set DATABASE_URL to a postgres connection string — no other schema changes
// needed.
//
// SQLite has no native enum type, so Role/AccountType/ItemStatus/PayoutStatus are
// plain strings here, validated against the TS union types + zod schemas in
// src/lib/enums.ts at every write.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  // "native" covers this dev machine's own engine (Linux); "windows" is added so
  // `npx prisma generate` also fetches the Windows query engine binary, which
  // server/scripts/build-windows.sh's pkg build bundles for the Windows test-deploy
  // executable. See root CLAUDE.md's packaging section.
  binaryTargets = ["native", "windows"]
}

model Store {
  id              String   @id @default(cuid())
  name            String
  location        String?
  itemPrefix      String   @default("TBX") // new items' SKU prefix: "<itemPrefix>-<itemNumber>" — see src/services/items.service.ts nextItemIdentity
  itemStartNumber Int      @default(1) // floor for the next new itemNumber; numbering otherwise continues from the store's highest
  createdAt       DateTime @default(now())

  users     UserRole[]
  accounts  Account[]
  items     Item[]
  devices   Device[]
  heartbeat Heartbeat?
  printJobs PrintJob[]
}

// Auth identity only. Permissions never derive from this record directly — always
// from the single active UserRole encoded into the session JWT. See UserRole.
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  // Sign-in-sheet badge (scan-to-login). Only a SHA-256 of the random code is stored —
  // the plaintext exists only on the printed sheet, so regenerating a sheet rotates the
  // code and the old one stops working. Null = no badge. See src/services/badge.service.ts.
  badgeCodeHash String?   @unique
  badgeIssuedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  roles         UserRole[]
  itemHistories ItemHistory[]
  sales         Sale[]
  auditLogs     AuditLog[]
  printJobs     PrintJob[]
}

// One row per role a person holds. A user with rows for both MANAGER and CONSIGNOR
// can only ever act as one of them per session (see auth.ts / requireRole) — this
// table exists to grant roles, not to be unioned at authorization time.
// `role` is one of: SYSTEM_ADMIN, OWNER, MANAGER, EMPLOYEE, REGISTER, CONSIGNOR,
// VENDOR, DONOR, BOOTH_OWNER (see src/lib/enums.ts ROLES).
model UserRole {
  id        String   @id @default(cuid())
  userId    String
  role      String
  storeId   String
  // Set when the role is account-scoped (CONSIGNOR, VENDOR, DONOR, BOOTH_OWNER):
  // identifies which Account this grant acts on.
  accountId String?
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id])
  store   Store    @relation(fields: [storeId], references: [id])
  account Account? @relation(fields: [accountId], references: [id])

  @@unique([userId, role, storeId])
}

// Polymorphic external/internal party that items and payouts attach to. Consignor,
// Vendor, Donor, and Booth Owner are all Accounts distinguished by `accountType`;
// every Store also gets one STORE-type Account representing store-owned inventory, so
// intake ALWAYS has a target account (see items.route.ts).
// `accountType` is one of: CONSIGNOR, VENDOR, DONOR, BOOTH_OWNER, STORE.
model Account {
  id             String    @id @default(cuid())
  storeId        String
  accountType    String
  name           String
  email          String?
  phone          String?
  paymentMethod  String? // JSON-encoded { method, details }
  mailingAddress String? // free text, concatenated — same convention as Store.location. No current write path (see server/CLAUDE.md).
  splitPercent   Int? // consignor/vendor/booth-owner revenue share, e.g. 60
  currentBalance Float     @default(0)
  isStoreAccount Boolean   @default(false) // an extra store-owned account (e.g. a shop's per-year "2019 Inventory" bucket): store-owned rules like the STORE type, but keeps its own accountType/history — see isBalanceBearing() in src/services/accounts.service.ts
  isActive       Boolean   @default(true) // false = dormant: hidden from default lists/pickers, excluded from payout-obligation totals, no new intake; balance kept — see server/CLAUDE.md "Accounts"
  legacyId       String? // source-system id for migrated accounts, e.g. "liberty:<CLIENT_ID>" — traces an account back to the old system's ledger
  lastSaleAt     DateTime? // denormalized MAX(Sale.saleDate) over this account's items — stamped by POS checkout, so the Accounts list doesn't aggregate ~1M sales per load
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  store     Store      @relation(fields: [storeId], references: [id])
  userRoles UserRole[]
  items     Item[]
  payouts   Payout[]

  @@index([storeId, accountType])
  @@index([legacyId])
}

// `status` is one of: PENDING, AVAILABLE, SOLD, DONATED, DISPOSED, RETURNED.
model Item {
  id              String    @id @default(cuid())
  sku             String    @unique // barcode value: formatBarcode(storeId, itemNumber) — see src/lib/barcode.ts
  itemNumber      Int // sequential per store, assigned alongside sku in the same transaction (src/routes/items.routes.ts)
  description     String
  category        String
  subcategory     String?
  brand           String?
  style           String?
  pattern         String?
  size            String?
  serialNumber    String?
  condition       String?
  consignmentType String? // e.g. "Traditional Consignment", "Buy-Outright", "Booth Rental", "Donation"
  status          String    @default("AVAILABLE")
  intakeDate      DateTime  @default(now())
  priceQuickSale  Float?
  price           Float // "standard" price — the sale price
  pricePremium    Float?
  cost            Float? // acquisition cost basis, e.g. for buy-outright/trade items. No current write path (see server/CLAUDE.md).
  // Per-item consignor share (%), overriding Account.splitPercent at checkout/payout —
  // Liberty sets the split per item (PRICE_CODE: 50/50, 30S/70C, "100% TO STORE" = 0).
  // Null = use the account's split. No write path in the app yet (migration only).
  consignorPercent Int?
  donateIfUnsold   Boolean? // consignor agreed unsold items are donated (Liberty ITEM.DONATE_IND); null = unknown
  tagPrintedAt     DateTime? // latest tag print — stamped by printItemsAsJob(); Liberty TAG_PRINTED_TS for migrated items
  // Inventory Audit classification (src/services/inventoryAudit.service.ts): a label is a
  // reviewable decision; "applying" it changes status/ownership and stamps auditAppliedAt.
  auditLabel       String?
  auditLabeledAt   DateTime?
  auditLabeledById String?
  auditAppliedAt   DateTime?
  accountId       String
  storeId         String
  // Denormalized for sorting/filtering ~1M items (computing them live took ~7s store-wide):
  // soldAt = latest Sale.saleDate, stamped by POS checkout; paidOutAt = latest date of a
  // non-REJECTED Payout with a line for this item, stamped by generatePaidPayout(). Anything
  // that writes sales/payout lines another way (seed, migrations) must backfill both — see
  // the add_item_sold_paid_dates migration for the canonical SQL.
  soldAt          DateTime?
  paidOutAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  account     Account       @relation(fields: [accountId], references: [id])
  store       Store         @relation(fields: [storeId], references: [id])
  photos      Photo[]
  history     ItemHistory[]
  sales       Sale[]
  payoutLines PayoutLine[]
  printLines  PrintJobItem[]

  @@unique([storeId, itemNumber])
  @@index([storeId, status])
  @@index([accountId])
  @@index([storeId, intakeDate])
  @@index([storeId, soldAt])
  @@index([storeId, paidOutAt])
  @@index([storeId, category])
  @@index([storeId, auditLabel])
  // Same three sorts scoped to one account (its Items table): without these SQLite walks
  // the store-wide date index filtering by account — seconds for an account whose
  // items are old.
  @@index([accountId, intakeDate])
  @@index([accountId, soldAt])
  @@index([accountId, paidOutAt])
}

model ItemHistory {
  id          String   @id @default(cuid())
  itemId      String
  changeType  String // "INTAKE" | "PRICE_CHANGE" | "STATUS_CHANGE" | "EDIT"
  oldValue    String?
  newValue    String?
  changedById String?
  activeRole  String?
  timestamp   DateTime @default(now())

  item      Item  @relation(fields: [itemId], references: [id])
  changedBy User? @relation(fields: [changedById], references: [id])

  @@index([timestamp]) // Reports > Day Detail's "Priced" list (PRICE_CHANGE entries by day)
}

model Photo {
  id        String   @id @default(cuid())
  itemId    String
  url       String
  source    String // "MANUAL" | "CV_STUB"
  createdAt DateTime @default(now())

  item Item @relation(fields: [itemId], references: [id])
}

model Sale {
  id            String   @id @default(cuid())
  itemId        String
  salePrice     Float
  saleDate      DateTime @default(now())
  paymentType   String // "CASH" | "CARD" | "STORE_CREDIT"
  registerName  String?
  processedById String?
  storeId       String
  // One checkout = one transaction (ticket); every Sale from the same POS checkout shares
  // it. Migrated sales carry "lib-<SALE_HDR.SALE_ID>". Null only for a sale with no known
  // ticket — reports count those as their own transaction (COALESCE(transactionId, id)).
  transactionId String?

  item        Item         @relation(fields: [itemId], references: [id])
  processedBy User?        @relation(fields: [processedById], references: [id])
  payoutLines PayoutLine[]

  @@index([storeId, saleDate])
  @@index([itemId])
}

// `status` is one of: REQUESTED, APPROVED, PAID, REJECTED.
model Payout {
  id           String    @id @default(cuid())
  payoutNumber Int       @unique // human-facing "Payout #": next = max + 1 (services/accounts.service.ts nextPayoutNumber); migrated payouts keep the source system's number. Globally unique (Payout has no storeId; one store per install).
  accountId    String
  amount       Float
  status       String    @default("REQUESTED")
  createdAt    DateTime  @default(now())
  paidAt       DateTime?
  method       String? // "CASH" | "CHECK" — how it was paid (Liberty PAYMENT_ACT); null = not recorded
  checkNumber  String?

  account Account      @relation(fields: [accountId], references: [id])
  lines   PayoutLine[]

  @@index([paidAt]) // Reports: payouts paid per day/week/year
  @@index([accountId, createdAt]) // per-account payout history, newest first; also lets payout search start from the account's payouts instead of every PayoutLine
}

// Itemization of a Payout: what it covered. Signed amounts (deductions/returns are
// negative); for a PAID payout they sum to Payout.amount. `lineType` is one of
// PAYOUT_LINE_TYPES (src/lib/enums.ts). A Sale with a PayoutLine has been paid out —
// that's how generating the next payout knows which sales are still owed.
model PayoutLine {
  id          String  @id @default(cuid())
  payoutId    String
  lineType    String
  itemId      String?
  saleId      String?
  description String?
  amount      Float

  payout Payout @relation(fields: [payoutId], references: [id])
  item   Item?  @relation(fields: [itemId], references: [id])
  sale   Sale?  @relation(fields: [saleId], references: [id])

  @@index([payoutId])
  @@index([itemId])
  @@index([saleId])
}

model Device {
  id             String   @id @default(cuid())
  storeId        String
  name           String
  type           String // "PRINTER" | "SCANNER" | "CASH_DRAWER" | "PAYMENT_TERMINAL"
  connectionInfo String? // JSON-encoded
  status         String   @default("DISCONNECTED")
  createdAt      DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id])
}

model Heartbeat {
  id           String   @id @default(cuid())
  storeId      String   @unique
  lastSyncedAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id])
}

// Immutable audit trail. Always records the activeRole a session was using, never
// just the user, per the security doc's "audit logs capture active role" rule.
model AuditLog {
  id            String   @id @default(cuid())
  entity        String
  entityId      String
  action        String
  performedById String?
  activeRole    String?
  timestamp     DateTime @default(now())
  details       String? // JSON-encoded

  performedBy User? @relation(fields: [performedById], references: [id])
}

// One tag print run ("print queue"): every POST /items/print-batch and every reprint
// from Reports > Print Queues creates one, so any batch can be found and printed again.
// `source` is "INTAKE" | "ITEM" (item page reprint) | "REPRINT" (from a past job,
// `reprintOfId`). See src/services/printJobs.service.ts.
model PrintJob {
  id          String   @id @default(cuid())
  storeId     String
  createdAt   DateTime @default(now())
  createdById String?
  activeRole  String?
  source      String
  reprintOfId String?
  itemCount   Int

  store     Store          @relation(fields: [storeId], references: [id])
  createdBy User?          @relation(fields: [createdById], references: [id])
  reprintOf PrintJob?      @relation("Reprints", fields: [reprintOfId], references: [id])
  reprints  PrintJob[]     @relation("Reprints")
  items     PrintJobItem[]

  @@index([storeId, createdAt])
}

// One tag in a PrintJob, with a snapshot of what was printed on it (the item's price
// or description may change later). `itemId` goes null if the item is deleted.
model PrintJobItem {
  id          String  @id @default(cuid())
  printJobId  String
  position    Int
  itemId      String?
  sku         String
  description String
  price       Float
  category    String?
  size        String?

  printJob PrintJob @relation(fields: [printJobId], references: [id], onDelete: Cascade)
  item     Item?    @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([printJobId])
  @@index([itemId])
}
