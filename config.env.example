# Optional config file for the Windows test-deploy build (dist-bin/teabox.exe).
#
# Copy this file next to teabox.exe and rename it to "config.env" to customize it.
# If no config.env is present, teabox.exe runs with the defaults commented out below.
# This file (once renamed) travels with teabox.exe and teabox.db as one portable set
# — safe to keep all three together on a USB drive or in one folder on the PC.

# Port the app listens on. Change this only if 4000 is already used by something
# else on the target machine.
#PORT=4000

# Signs login sessions (JWT). The built-in default is fine for a short test deploy on
# a machine only the shop uses; set your own random string here before any deploy
# that will hold real, ongoing shop data.
#JWT_SECRET=change-me-to-something-random

# Normally irrelevant for the packaged .exe: the web client is served from the same
# origin/port as the API, so the browser never makes a cross-origin request that
# would need this. Only matters if you point a browser at this API from elsewhere.
#CORS_ORIGIN=http://localhost:5173
